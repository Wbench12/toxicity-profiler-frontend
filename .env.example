# Frontend Environment Configuration
# Copy this file to .env.local and update values for your environment

# API Base URL - Point to your FastAPI backend
# For local development: http://localhost:8000
# For production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Optional: Enable debug logging
# VITE_DEBUG=true

# Optional: Indigo structure service for 3D coordinates
# Use the relative proxy path so the frontend can route requests through Vite (dev)
# or your production reverse proxy without CORS headaches.
# Example: /indigo-proxy/v2
VITE_INDIGO_BASE_URL=

# Host that actually runs the Indigo REST service (used by the dev proxy)
# Example: http://localhost:8001 (host port 8001 mapped to container port 80)
INDIGO_PROXY_TARGET=
